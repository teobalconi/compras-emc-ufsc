# Supabase (Frontend - Configuracoes > API no painel do Supabase)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# GitHub Actions Dispatch (Opcional - para disparar e-mails/agenda manualmente pela interface web)
# Crie um Fine-grained Personal Access Token com permissao 'Actions: Read and write' neste repositorio
VITE_GITHUB_REPO=seu-usuario/compras-emc-ufsc
VITE_GITHUB_DISPATCH_TOKEN=github_pat_xxxxxxxxxxxxx
